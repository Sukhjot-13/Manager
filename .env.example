# Manager — local dev env template. Copy to .env.local and fill in.
# Never commit real values. See docs/plan.md §2 + §7 for details.

# MongoDB Atlas connection string (required from P0 onward)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Signs the admin session cookie (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=change-me-32-bytes-min

# Single-admin login (v1 simple auth)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# AES-256-GCM master key for secrets vault, 64 hex chars (32 bytes)
ENV_MASTER_KEY=change-me-64-hex-chars

# Secret HMAC pepper for anonymous analytics visitor IDs
VISITOR_PEPPER=change-me

# Optional: higher rate limit for GitHub repo enrichment
# GITHUB_TOKEN=
# Optional: display timezone for dashboards (default UTC)
# APP_TZ=UTC
