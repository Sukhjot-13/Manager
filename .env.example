# Manager — local dev env template. Copy to .env.local and fill in.
# Never commit real values. See docs/plan.md §2 + §7 and docs/architecture.md for details.

# MongoDB Atlas connection string (required — the app fails closed without it)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Signs the admin session cookie (jose HS256, 7d expiry).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it instantly invalidates every session (the only true server-side revocation).
AUTH_SECRET=change-me-32-bytes-min

# Single-admin login (v1 auth) — the owner signs in with these
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# AES-256-GCM master key for the secrets vault, 64 hex chars (32 bytes).
# BACK THIS UP OFFLINE — losing it makes every stored secret permanently unreadable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENV_MASTER_KEY=change-me-64-hex-chars

# Secret HMAC pepper for anonymous analytics visitor IDs (daily-rotating).
# Rotating it resets unique-visitor counts. Generate like AUTH_SECRET.
VISITOR_PEPPER=change-me

# Optional: higher GitHub API rate limit for repo enrichment (read-only fine-grained PAT)
# GITHUB_TOKEN=
# Optional: display timezone for dashboards (default UTC)
# APP_TZ=UTC
